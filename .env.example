# Copy this file to .env and fill in your own values. Never commit .env.

# Groq API settings - https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant
# Local Embeddings & Vector Store settings (runs locally, no API key needed)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
VECTOR_STORE_PATH=./vector_store

# Any long random string (min 32 chars). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=replace_with_a_random_string_of_at_least_32_characters

# Optional Campus Events API integration
CAMPUS_EVENTS_API_URL=
CAMPUS_EVENTS_API_KEY=

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5183,http://127.0.0.1:5183,https://campus-copilot-frontend-groq.vercel.app,https://campus-copilot.vercel.app

# Database connection string. Leave out or use sqlite for local file DB:
DATABASE_URL=sqlite:///./campus_copilot.db
